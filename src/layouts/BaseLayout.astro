---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pubDate?: Date;
}

const {
  title = 'Frans Alwan Purba | AI Research & Academic Portfolio',
  description = 'Master of Computer Science (M.Cs.) in Artificial Intelligence at Universitas Gadjah Mada (UGM). Research on Cost-Sensitive ML, Explainable AI Stability, and Trustworthy AI. Prospective Ph.D. Applicant.',
  ogImage = '/og-default.png',
  pubDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kognitif-blog.netlify.app');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Frans Alwan Purba" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pubDate ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Prevent Theme Flash (Zero-FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-neutral-50 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 flex flex-col antialiased selection:bg-neutral-200 dark:selection:bg-neutral-800 transition-colors duration-200">
    <header class="border-b border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/90 dark:bg-neutral-950/90 sticky top-0 z-20 backdrop-blur-sm">
      <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-600 dark:bg-emerald-400 group-hover:scale-125 transition-transform"></span>
          <div class="flex flex-col">
            <span class="font-mono text-sm font-bold tracking-tight text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              Frans Alwan Purba
            </span>
            <span class="text-[10px] font-mono text-neutral-500 dark:text-neutral-400 -mt-0.5">
              kognitif_lab // UGM AI
            </span>
          </div>
        </a>

        <div class="flex items-center gap-4 sm:gap-6">
          <nav class="flex items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-400">
            <a href="/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Research</a>
            <a href="/#thesis" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Thesis</a>
            <a href="/about" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Bio &amp; CV</a>
            <a href="/workbench" class="hidden sm:inline hover:text-cyan-600 dark:hover:text-cyan-400 font-mono text-xs transition-colors">
              Workbench
            </a>
          </nav>

          <!-- Light/Dark Mode Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark/light theme"
            class="p-2 rounded-lg border border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 shadow-xs transition-all focus:outline-none"
          >
            <!-- Sun icon for dark mode (click to switch to light) -->
            <svg id="sun-icon" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon icon for light mode (click to switch to dark) -->
            <svg id="moon-icon" class="w-4 h-4 block dark:hidden text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-4xl w-full mx-auto px-6 py-10 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-neutral-200 dark:border-neutral-900 py-8 text-neutral-600 dark:text-neutral-500 text-xs font-mono transition-colors">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
        <div>
          <p class="font-semibold text-neutral-800 dark:text-neutral-300">Frans Alwan Purba</p>
          <p class="text-neutral-500 text-[11px]">
            Master of Computer Science (M.Cs.) in Artificial Intelligence &middot; Universitas Gadjah Mada (UGM)
          </p>
          <p class="text-neutral-500 text-[11px]">
            Prospective Ph.D. Applicant
          </p>
        </div>
        <div class="flex items-center gap-4 text-[11px]">
          <a href="https://github.com/fransalwan" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400">GitHub</a>
          <a href="mailto:fransalwanpurba@mail.ugm.ac.id" class="hover:text-emerald-600 dark:hover:text-emerald-400">Email</a>
          <a href="/about" class="hover:text-emerald-600 dark:hover:text-emerald-400">Curriculum Vitae</a>
        </div>
      </div>
    </footer>

    <!-- Minimal Script for Theme Switching -->
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    </script>
  </body>
</html>
