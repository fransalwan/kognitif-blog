---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<BaseLayout
  title="Frans Alwan Purba | Academic Research Portfolio (AI & Trustworthy ML)"
  description="Academic portfolio and research notes of Frans Alwan Purba, Master of Computer Science (M.Cs.) student in Artificial Intelligence at Universitas Gadjah Mada (UGM), prospective Ph.D. applicant."
>
  <!-- Academic Hero / Researcher Profile -->
  <section class="mb-14 pb-12 border-b border-neutral-200 dark:border-neutral-800 transition-colors">
    <div class="flex flex-col sm:flex-row items-start justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-emerald-100/80 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800/60 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse"></span>
          Prospective Ph.D. Applicant
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight font-mono text-neutral-900 dark:text-neutral-100 mb-2">
          Frans Alwan Purba
        </h1>
        <p class="text-sm sm:text-base font-mono text-neutral-600 dark:text-neutral-400 mb-4">
          Master of Computer Science (M.Cs.) in Artificial Intelligence &middot; Universitas Gadjah Mada (UGM)
        </p>

        <p class="text-neutral-700 dark:text-neutral-300 text-sm sm:text-base leading-relaxed mb-6">
          I am a Master's student in Computer Science (M.Cs. program in Artificial Intelligence) at Universitas Gadjah Mada (UGM) investigating the causal frontiers of <strong>Trustworthy Machine Learning</strong>, with an emphasis on <strong>Instance-Dependent Cost-Sensitive (IDCS) learning</strong> and <strong>Explainable AI (XAI) stability</strong>. My current work diagnoses why profit-driven loss functions undermine explanation consistency in high-stakes automated decisions, and develops structural regularization to restore algorithmic accountability.
        </p>

        <!-- Quick Links & Contact -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
          <a
            href="#thesis"
            class="px-3.5 py-1.5 rounded-md bg-neutral-900 text-neutral-100 dark:bg-neutral-100 dark:text-neutral-900 font-semibold hover:opacity-90 transition-opacity"
          >
            Master's Thesis &darr;
          </a>
          <a
            href="/about"
            class="px-3.5 py-1.5 rounded-md border border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-500 text-neutral-800 dark:text-neutral-200 transition-colors"
          >
            Academic CV &amp; Bio &rarr;
          </a>
          <a
            href="https://github.com/fransalwan"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-md border border-neutral-300 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-600 dark:text-neutral-400 transition-colors"
          >
            GitHub
          </a>
          <a
            href="mailto:fransalwanpurba@mail.ugm.ac.id"
            class="px-3 py-1.5 rounded-md border border-neutral-300 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-600 dark:text-neutral-400 transition-colors"
          >
            fransalwanpurba@mail.ugm.ac.id
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Master's Thesis Section -->
  <section id="thesis" class="mb-14 scroll-mt-20">
    <div class="flex items-center justify-between pb-3 mb-6 border-b border-neutral-200 dark:border-neutral-800">
      <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 font-semibold flex items-center gap-2">
        <span class="text-emerald-600 dark:text-emerald-400">&#9656;</span> Featured Research &middot; Master's Thesis
      </h2>
      <span class="text-xs font-mono px-2 py-0.5 rounded border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300">
        In Progress (2026)
      </span>
    </div>

    <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/50 shadow-sm backdrop-blur-sm transition-colors">
      <div class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-semibold mb-2">
        Master of Computer Science (M.Cs.) Thesis Proposal &middot; FMIPA Universitas Gadjah Mada
      </div>
      <h3 class="text-xl sm:text-2xl font-bold font-mono text-neutral-900 dark:text-neutral-100 mb-3 leading-snug">
        Stabilisasi Penjelasan Model Instance-Dependent Cost-Sensitive Menggunakan Regularisasi dan Uji Permutasi Biaya Terstratifikasi
      </h3>
      <p class="text-xs font-mono text-neutral-500 mb-4">
        Author: <strong>Frans Alwan Purba</strong> &middot; Target Publication: European Journal of Operational Research (EJOR) / IEEE Trans.
      </p>

      <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed mb-6">
        Instance-Dependent Cost-Sensitive (IDCS) classifiers significantly improve cost-efficiency in credit scoring by incorporating customer-specific loan amounts into the loss function. However, recent benchmarks (Ballegeer et al., 2025) demonstrate that IDCS models generate severely unstable SHAP and LIME explanations under class imbalance ($p &lt; 0.001$). This study introduces a <strong>two-pronged diagnostic framework</strong>: (1) employing parametric regularization to constrain weight complexity without sacrificing cost savings, and (2) performing stratified cost permutation (cost-shuffle) to establish the first causal evidence for the <em>feature-cost entanglement</em> hypothesis.
      </p>

      <div class="grid sm:grid-cols-2 gap-3 p-4 rounded-lg bg-neutral-100/80 dark:bg-neutral-950/60 border border-neutral-200 dark:border-neutral-800 text-xs font-mono mb-6">
        <div>
          <span class="text-neutral-900 dark:text-neutral-200 font-semibold block mb-1">Arm 1 &middot; Regularization Intervention</span>
          Assessing $L_1/L_2$, inverse regularization $C$, and tree-depth tuning to curb gradient swings and stabilize CoV/SRA beyond the explainer noise floor.
        </div>
        <div>
          <span class="text-neutral-900 dark:text-neutral-200 font-semibold block mb-1">Arm 2 &middot; Causal Cost-Shuffle Test</span>
          Decoupling instance costs from customer features via stratified permutation to verify if instability stems from cost entanglement.
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-neutral-200 dark:border-neutral-800 text-xs font-mono">
        <div class="flex gap-2 text-neutral-600 dark:text-neutral-400">
          <span>#IDCS</span>
          <span>#ExplainableAI</span>
          <span>#CostSensitiveML</span>
          <span>#EU_AI_Act</span>
        </div>
        <a
          href="/blog/cost-interpretability-dilemma-idcs"
          class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
        >
          Read Theoretical Breakdown &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Published Academic Essays -->
  <section class="mb-14">
    <div class="flex items-center justify-between pb-3 mb-6 border-b border-neutral-200 dark:border-neutral-800">
      <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 font-semibold flex items-center gap-2">
        <span class="text-emerald-600 dark:text-emerald-400">&#9656;</span> Research Essays &amp; Technical Notes
      </h2>
      <span class="text-xs font-mono text-neutral-500">
        {posts.length} {posts.length === 1 ? 'publication' : 'publications'}
      </span>
    </div>

    <div class="divide-y divide-neutral-200 dark:divide-neutral-900">
      {posts.length === 0 && (
        <div class="py-12 text-center border border-dashed border-neutral-300 dark:border-neutral-800 rounded-lg my-4">
          <p class="text-neutral-600 dark:text-neutral-400 font-mono text-sm mb-1">No essays published yet.</p>
          <p class="text-neutral-500 font-mono text-xs">Research deconstructions are active in the Workbench.</p>
        </div>
      )}
      {posts.map((post) => (
        <article class="py-6 group">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <h3 class="text-lg sm:text-xl font-bold font-mono text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              <a href={`/blog/${post.slug}`} class="focus:outline-none focus:underline">
                {post.data.title}
              </a>
            </h3>
            <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-neutral-500 shrink-0">
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-3 line-clamp-2">
            {post.data.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
                #{tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
