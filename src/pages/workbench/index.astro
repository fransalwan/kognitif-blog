---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allResearch = await getCollection('research');
const allBlogPosts = await getCollection('blog');

// Sort research by addedDate descending
allResearch.sort((a, b) => b.data.addedDate.valueOf() - a.data.addedDate.valueOf());

const statusColors: Record<string, string> = {
  reading: 'border-blue-300 dark:border-blue-500/30 bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300',
  deconstructing: 'border-amber-300 dark:border-amber-500/30 bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300',
  synthesizing: 'border-purple-300 dark:border-purple-500/30 bg-purple-50 dark:bg-purple-950/40 text-purple-800 dark:text-purple-300',
  ready_to_draft: 'border-emerald-300 dark:border-emerald-500/30 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300',
  published: 'border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-400',
};

const statusLabels: Record<string, string> = {
  reading: '1. Reading Paper',
  deconstructing: '2. Deconstructing',
  synthesizing: '3. Cognitive Synthesis',
  ready_to_draft: '4. Ready to Draft',
  published: '5. Published',
};
---

<BaseLayout
  title="Cognitive Workbench | kognitif-blog"
  description="Thesis literature synthesis dashboard and active-recall research pipeline for Frans Alwan Purba (M.Cs. in AI @ UGM)."
>
  <div class="mb-10">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-cyan-600 dark:bg-cyan-400 animate-pulse"></span>
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-700 dark:text-cyan-400 font-semibold">
        Thesis Research Synthesis Lab
      </span>
    </div>
    <h1 class="text-3xl font-mono font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
      Research Workbench<span class="text-cyan-600 dark:text-cyan-400">.</span>
    </h1>
    <p class="text-neutral-600 dark:text-neutral-400 text-sm mt-2 max-w-2xl leading-relaxed">
      Ruang dekonstruksi literatur primer, sintesis epistemologis berbasis teknik Feynman, dan pelacakan progres hipotesis riset tesis Magister (IDCS, XAI Stability &amp; Algorithmic Regularization).
    </p>
  </div>

  <!-- Metric Badges -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
    <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/50 shadow-xs transition-colors">
      <div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-1">Total Literatur</div>
      <div class="text-2xl font-mono font-bold text-neutral-900 dark:text-neutral-100">{allResearch.length}</div>
    </div>
    <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/50 shadow-xs transition-colors">
      <div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-1">Tahap Sintesis</div>
      <div class="text-2xl font-mono font-bold text-purple-700 dark:text-purple-400">
        {allResearch.filter(r => r.data.status === 'synthesizing' || r.data.status === 'deconstructing').length}
      </div>
    </div>
    <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/50 shadow-xs transition-colors">
      <div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-1">Siap Jadi Draft</div>
      <div class="text-2xl font-mono font-bold text-emerald-700 dark:text-emerald-400">
        {allResearch.filter(r => r.data.status === 'ready_to_draft').length}
      </div>
    </div>
    <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/50 shadow-xs transition-colors">
      <div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-1">Esai Terbit</div>
      <div class="text-2xl font-mono font-bold text-neutral-900 dark:text-neutral-100">{allBlogPosts.length}</div>
    </div>
  </div>

  <!-- Thesis Cognitive Framework Reference -->
  <section class="mb-12 p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/40 transition-colors">
    <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-800 dark:text-neutral-300 font-bold mb-3 flex items-center gap-2">
      <span class="text-cyan-600 dark:text-cyan-400 font-bold">&#9656;</span> Framework Kritis Tesis (3 Pilar Evaluasi IDCS &amp; XAI)
    </h2>
    <div class="grid sm:grid-cols-3 gap-4 text-xs font-mono text-neutral-600 dark:text-neutral-400">
      <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800/80 bg-white dark:bg-neutral-950 transition-colors">
        <span class="text-neutral-900 dark:text-neutral-200 font-semibold block mb-1">1. Curvature &amp; Regularization</span>
        Meredam osilasi gradien lokal akibat nominal pinjaman ekstrem ($A_i$) menggunakan penalti parametrik ($L_1/L_2$, inverse $C$, max-depth).
      </div>
      <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800/80 bg-white dark:bg-neutral-950 transition-colors">
        <span class="text-neutral-900 dark:text-neutral-200 font-semibold block mb-1">2. Noise Floor Calibration</span>
        Mengisolasi derau stokastik inheren dari estimator perturbasi (KernelSHAP/LIME) melalui baseline pengulangan acak berulang.
      </div>
      <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800/80 bg-white dark:bg-neutral-950 transition-colors">
        <span class="text-neutral-900 dark:text-neutral-200 font-semibold block mb-1">3. Causal Cost-Shuffle Test</span>
        Memvalidasi hipotesis <em>feature-cost entanglement</em> dengan memutus korelasi fitur dan biaya lewat permutasi terstratifikasi.
      </div>
    </div>
  </section>

  <!-- Research Papers Pipeline -->
  <section>
    <div class="flex items-center justify-between pb-3 mb-6 border-b border-neutral-200 dark:border-neutral-800">
      <h2 class="text-sm font-mono uppercase tracking-wider text-neutral-800 dark:text-neutral-300 font-bold">
        Daftar Dekonstruksi Literatur Tesis
      </h2>
      <span class="text-xs font-mono text-neutral-500">File di <code class="px-1 py-0.5 rounded bg-neutral-200/70 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">src/content/research/</code></span>
    </div>

    <div class="space-y-4">
      {allResearch.map((item) => (
        <article class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 hover:border-neutral-300 dark:hover:border-neutral-700 shadow-xs transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-3">
            <div>
              <span class={`inline-block text-xs font-mono px-2 py-0.5 rounded border mb-2 font-medium ${statusColors[item.data.status]}`}>
                {statusLabels[item.data.status]}
              </span>
              <h3 class="text-lg font-bold font-mono text-neutral-900 dark:text-neutral-100">
                <a href={`/workbench/${item.slug}`} class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                  {item.data.title}
                </a>
              </h3>
              <p class="text-xs font-mono text-neutral-600 dark:text-neutral-400 mt-1">
                Paper: <span class="italic text-neutral-800 dark:text-neutral-300">"{item.data.paperTitle}"</span> &middot; {item.data.venue} ({item.data.year})
              </p>
            </div>
            <a
              href={item.data.doiOrUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 text-xs font-mono text-neutral-600 dark:text-neutral-400 hover:text-cyan-600 dark:hover:text-cyan-400 border border-neutral-200 dark:border-neutral-800 rounded px-2.5 py-1 bg-neutral-50 dark:bg-neutral-950 transition-colors"
            >
              DOI Link &rarr;
            </a>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-neutral-100 dark:border-neutral-800/60 text-xs font-mono">
            <div class="flex flex-wrap gap-2">
              {item.data.tags.map((tag: string) => (
                <span class="text-neutral-500 dark:text-neutral-400">#{tag}</span>
              ))}
            </div>
            <a href={`/workbench/${item.slug}`} class="text-cyan-600 dark:text-cyan-400 font-semibold hover:underline">
              Buka Catatan Dekonstruksi &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
