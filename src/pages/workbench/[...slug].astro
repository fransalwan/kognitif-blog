---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allResearch = await getCollection('research');
  return allResearch.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'research'>;
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<BaseLayout
  title={`${item.data.title} | Workbench`}
  description={`Catatan riset dan dekonstruksi paper: ${item.data.paperTitle}`}
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800 transition-colors">
      <div class="mb-4 flex items-center justify-between">
        <a href="/workbench" class="text-xs font-mono text-cyan-600 dark:text-cyan-400 font-semibold hover:underline">
          &larr; Kembali ke Workbench
        </a>
        <span class="text-xs font-mono px-2.5 py-1 rounded border border-purple-300 dark:border-purple-500/30 bg-purple-50 dark:bg-purple-950/40 text-purple-800 dark:text-purple-300 uppercase font-medium">
          Status: {item.data.status}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold font-mono text-neutral-900 dark:text-neutral-100 mb-4 leading-snug">
        {item.data.title}
      </h1>

      <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-xs font-mono space-y-1.5 text-neutral-600 dark:text-neutral-400 shadow-xs transition-colors">
        <div><strong class="text-neutral-900 dark:text-neutral-200">Jurnal Asli:</strong> {item.data.paperTitle}</div>
        <div><strong class="text-neutral-900 dark:text-neutral-200">Penulis:</strong> {item.data.authors.join(', ')}</div>
        <div><strong class="text-neutral-900 dark:text-neutral-200">Venue:</strong> {item.data.venue} ({item.data.year})</div>
        <div>
          <strong class="text-neutral-900 dark:text-neutral-200">Tautan:</strong>{' '}
          <a href={item.data.doiOrUrl} target="_blank" rel="noopener noreferrer" class="text-cyan-600 dark:text-cyan-400 underline font-semibold hover:opacity-80">
            {item.data.doiOrUrl}
          </a>
        </div>
      </div>
    </header>

    <div class="prose dark:prose-invert prose-lg max-w-none prose-neutral prose-headings:font-mono prose-headings:font-semibold prose-headings:text-neutral-900 dark:prose-headings:text-neutral-100 prose-p:text-neutral-800 dark:prose-p:text-neutral-300 prose-li:text-neutral-800 dark:prose-li:text-neutral-300 prose-a:text-cyan-600 dark:prose-a:text-cyan-400 prose-pre:border prose-pre:border-neutral-200 dark:prose-pre:border-neutral-800 prose-pre:bg-neutral-900 prose-pre:text-neutral-100 prose-code:text-cyan-800 dark:prose-code:text-cyan-300 prose-code:bg-cyan-50 dark:prose-code:bg-cyan-950/40 prose-code:border prose-code:border-cyan-200 dark:prose-code:border-cyan-800/40 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none transition-colors">
      <Content />
    </div>
  </article>
</BaseLayout>
