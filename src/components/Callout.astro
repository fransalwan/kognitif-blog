---
interface Props {
  type?: 'info' | 'warning' | 'tip';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const styles = {
  info: 'border-cyan-500/40 bg-cyan-950/20 text-cyan-200',
  warning: 'border-amber-500/40 bg-amber-950/20 text-amber-200',
  tip: 'border-emerald-500/40 bg-emerald-950/20 text-emerald-200',
};

const titleStyles = {
  info: 'text-cyan-400',
  warning: 'text-amber-400',
  tip: 'text-emerald-400',
};
---

<aside class={`my-6 rounded-lg border p-4 not-prose ${styles[type]}`} role="note">
  {title && (
    <div class={`text-xs font-mono font-semibold tracking-wider uppercase mb-1.5 ${titleStyles[type]}`}>
      {title}
    </div>
  )}
  <div class="text-sm leading-relaxed text-neutral-300">
    <slot />
  </div>
</aside>

